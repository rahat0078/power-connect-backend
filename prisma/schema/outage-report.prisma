model OutageReport {
  id          String       @id @default(uuid())
  userId      String
  area        String
  description String
  status      OutageStatus @default(PENDING)
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("outage_reports")
}
