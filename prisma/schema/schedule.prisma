model PowerSchedule {
  id          String         @id @default(uuid())
  area        String
  startTime   DateTime
  endTime     DateTime
  description String?
  status      ScheduleStatus @default(SCHEDULED)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("power_schedules")
}
